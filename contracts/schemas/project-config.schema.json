{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/recommendation/project-config.schema.json",
  "title": "ProjectConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_version",
    "minimum_app_version",
    "project_code",
    "default_language",
    "supported_languages",
    "theme",
    "content",
    "navigation",
    "emotion_profiles",
    "analysis_mappings",
    "locations",
    "items",
    "rules"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "config_version": { "type": "integer", "minimum": 1 },
    "minimum_app_version": { "type": "integer", "minimum": 1 },
    "project_code": { "type": "string", "minLength": 1 },
    "default_language": { "type": "string", "minLength": 2 },
    "supported_languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "theme": { "$ref": "#/$defs/theme" },
    "content": { "$ref": "#/$defs/content" },
    "navigation": { "$ref": "#/$defs/navigation" },
    "emotion_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/emotionProfile" }
    },
    "analysis_mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/analysisMapping" }
    },
    "locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/location" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "rich_flow": { "$ref": "#/$defs/richFlow" }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 2 } } },
      "then": { "required": ["rich_flow"] }
    }
  ],
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "primary_color", "background_image_url", "map_image_url"],
      "properties": {
        "name": { "$ref": "#/$defs/localizedText" },
        "logo_url": { "type": ["string", "null"] },
        "primary_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "background_image_url": { "type": "string" },
        "map_image_url": { "type": "string" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home_introduction", "result_item_label", "map_button_label", "current_location_label", "map_gesture_hint"],
      "properties": {
        "home_introduction": { "$ref": "#/$defs/localizedText" },
        "result_item_label": { "$ref": "#/$defs/localizedText" },
        "map_button_label": { "$ref": "#/$defs/localizedText" },
        "current_location_label": { "$ref": "#/$defs/localizedText" },
        "map_gesture_hint": { "$ref": "#/$defs/localizedText" }
      }
    },
    "mapPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_percent", "y_percent"],
      "properties": {
        "x_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "y_percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "routes_by_location_code"],
      "properties": {
        "origin": { "$ref": "#/$defs/mapPoint" },
        "routes_by_location_code": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/mapPoint" } }
        }
      }
    },
    "emotionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "message", "color", "active"],
      "properties": {
        "code": { "type": "string" },
        "name": { "$ref": "#/$defs/localizedText" },
        "message": { "$ref": "#/$defs/localizedText" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "icon": { "type": ["string", "null"] },
        "active": { "type": "boolean" }
      }
    },
    "analysisMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_label", "emotion_code"],
      "properties": {
        "source_label": { "type": "string", "minLength": 1 },
        "emotion_code": { "type": "string", "minLength": 1 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "status", "marker", "active"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "code": { "type": "string" },
        "name": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "image_url": { "type": ["string", "null"] },
        "capacity": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "enum": ["NORMAL", "CONGESTED", "PAUSED"] },
        "marker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_percent", "y_percent"],
          "properties": {
            "x_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "y_percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "active": { "type": "boolean" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "location_id", "name", "description", "image_url", "active"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "type": "string" },
        "location_id": { "type": "string", "format": "uuid" },
        "name": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "image_url": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": true },
        "active": { "type": "boolean" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emotion_code", "item_id", "weight", "priority", "active"],
      "properties": {
        "emotion_code": { "type": "string" },
        "item_id": { "type": "string", "format": "uuid" },
        "weight": { "type": "integer", "minimum": 0 },
        "priority": { "type": "integer", "minimum": 0 },
        "active": { "type": "boolean" }
      }
    },
    "richFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_policy", "senses", "condition_states", "journey_mappings", "venue_operations", "kiosks", "congestion_policy"],
      "properties": {
        "measurement_policy": { "$ref": "#/$defs/measurementPolicy" },
        "senses": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/sense" } },
        "condition_states": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/conditionState" } },
        "journey_mappings": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/journeyMapping" } },
        "venue_operations": { "type": "array", "items": { "$ref": "#/$defs/venueOperation" } },
        "kiosks": { "type": "array", "items": { "$ref": "#/$defs/kiosk" } },
        "congestion_policy": { "$ref": "#/$defs/congestionPolicy" }
      }
    },
    "confirmationStatus": { "enum": ["CONFIRMED", "PENDING_CONFIRMATION"] },
    "measurementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_seconds", "result_display_seconds", "idle_return_seconds", "max_attempts", "heart_rate_range", "respiration_range", "au_calibration_frames", "au_low_upper", "au_medium_upper", "overheat_stress_threshold", "confidence_threshold"],
      "properties": {
        "measurement_seconds": { "type": "integer", "minimum": 1 },
        "result_display_seconds": { "type": "integer", "minimum": 1 },
        "idle_return_seconds": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "heart_rate_range": { "$ref": "#/$defs/intRange" },
        "respiration_range": { "$ref": "#/$defs/intRange" },
        "au_calibration_frames": { "type": "integer", "minimum": 1 },
        "au_low_upper": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "au_medium_upper": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "overheat_stress_threshold": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "intRange": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }
    },
    "sense": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "name", "order", "active"],
      "properties": {
        "code": { "enum": ["INSIGHT", "SCENT", "TASTE", "LISTENING", "ACTION", "INTUITION"] },
        "name": { "$ref": "#/$defs/localizedText" },
        "order": { "type": "integer", "minimum": 1, "maximum": 6 },
        "active": { "type": "boolean" }
      }
    },
    "conditionState": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "group", "display_name", "message", "stress_band", "tension_band", "primary_sense", "compass_values", "active"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "group": { "enum": ["A", "B", "C", "D", "E", "F"] },
        "display_name": { "$ref": "#/$defs/localizedText" },
        "message": { "$ref": "#/$defs/localizedText" },
        "stress_band": { "enum": ["LOW", "NORMAL", "MODERATELY_HIGH", "HIGH"] },
        "tension_band": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "primary_sense": { "type": "string" },
        "compass_values": { "type": "object", "minProperties": 6, "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 } },
        "active": { "type": "boolean" }
      }
    },
    "journeyMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_code", "sense_sequence"],
      "properties": {
        "condition_code": { "type": "string" },
        "sense_sequence": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "exception_code": { "type": ["string", "null"] }
      }
    },
    "venueOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "name", "sense_codes", "zone_code", "marker", "capacity", "recommendation_ttl_minutes", "indoor", "family_priority", "high_stimulation", "alcohol", "confirmation_status", "active"],
      "properties": {
        "code": { "type": "string" },
        "name": { "$ref": "#/$defs/localizedText" },
        "sense_codes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "zone_code": { "type": ["string", "null"] },
        "marker": { "anyOf": [{ "$ref": "#/$defs/mapPoint" }, { "type": "null" }] },
        "capacity": { "type": ["integer", "null"], "minimum": 1 },
        "recommendation_ttl_minutes": { "enum": [40, 60, 90] },
        "indoor": { "type": ["boolean", "null"] },
        "family_priority": { "type": "boolean" },
        "high_stimulation": { "type": "boolean" },
        "alcohol": { "type": "boolean" },
        "confirmation_status": { "$ref": "#/$defs/confirmationStatus" },
        "active": { "type": "boolean" }
      }
    },
    "kiosk": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "installation_group", "zone_code", "marker", "quantity", "confirmation_status", "active"],
      "properties": {
        "code": { "type": "string" },
        "installation_group": { "type": "string" },
        "zone_code": { "type": ["string", "null"] },
        "marker": { "anyOf": [{ "$ref": "#/$defs/mapPoint" }, { "type": "null" }] },
        "quantity": { "type": "integer", "minimum": 1 },
        "confirmation_status": { "$ref": "#/$defs/confirmationStatus" },
        "active": { "type": "boolean" }
      }
    },
    "congestionPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["normal_under_percent", "busy_under_percent", "exclude_at_percent", "companion_exclude_at_percent", "rain_indoor_normal_under_percent", "rain_indoor_busy_under_percent", "meal_windows", "closing_cutoff_minutes"],
      "properties": {
        "normal_under_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "busy_under_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "exclude_at_percent": { "type": "integer", "minimum": 0 },
        "companion_exclude_at_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "rain_indoor_normal_under_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "rain_indoor_busy_under_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "meal_windows": { "type": "array", "items": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]-[0-2][0-9]:[0-5][0-9]$" } },
        "closing_cutoff_minutes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
